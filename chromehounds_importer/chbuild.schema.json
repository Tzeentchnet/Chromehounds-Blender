{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chromehounds Blender Build",
  "type": "object",
  "required": ["version", "parts"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "socket": {
            "type": ["string", "integer"]
          },
          "matrix": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            }
          },
          "location": {
            "$ref": "#/$defs/vector3"
          },
          "rotation_degrees": {
            "$ref": "#/$defs/vector3"
          },
          "scale": {
            "$ref": "#/$defs/vector3"
          }
        }
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  }
}
